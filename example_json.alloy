prometheus.exporter.json "example" {
	url = "http://localhost:8080/metrics.json"

	// Mapping pattern: emit ONE series per item in an array
	mapping {
		array {
			items_path = ".items[*]"

			metric {
				name   = "app_info"
				type   = "gauge"
				value  = 1
				labels = {
					app_name      = ".app_name",
					health_status = ".health_status",
					sync_status   = ".sync_status",
					namespace     = ".namespace",
				}
			}
		}
	}
}

prometheus.scrape "json_example" {
	scrape_interval = "11s"
	targets         = prometheus.exporter.json.example.targets
	forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
	endpoint {
		url = "http://localhost:9090/api/v1/write"
	}
}
